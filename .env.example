# ---------------------------------------------------------------
# Copy this file to `.env` and replace every CHANGE_ME value.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------

# --- Airflow runtime --------------------------------------------
# Linux/macOS: run `id -u` and use that value. Windows/WSL: keep 50000.
AIRFLOW_UID=50000

# Generate each secret once and keep them stable between restarts:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   -> AIRFLOW_FERNET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                 -> AIRFLOW_JWT_SECRET, AIRFLOW_API_SECRET_KEY
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME
AIRFLOW_API_SECRET_KEY=CHANGE_ME

# Airflow metadata database (internal to Airflow, not part of the data product)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_DB_NAME=airflow

# --- Data database (hosts BOTH the Grammy source DB and the Data Warehouse) ---
DATA_DB_USER=etl_user
DATA_DB_PASSWORD=CHANGE_ME
DATA_DB_HOST=postgres-data
DATA_DB_PORT=5432
SOURCE_DB_NAME=grammy_source
DW_DB_NAME=music_dw

# Host-side ports (bound to 127.0.0.1): data DB for psql / BI tool / notebook, and the Airflow UI
DATA_DB_HOST_PORT=5433
AIRFLOW_HOST_PORT=8080

# --- Input file locations (paths as seen INSIDE the containers) ---
SPOTIFY_CSV_PATH=/opt/airflow/data/raw/spotify_dataset.csv
GRAMMY_CSV_PATH=/opt/airflow/data/raw/the_grammy_awards.csv
